{
    "latex-workshop.latex.outDir": "%DIR%",
    "latex-workshop.latex.clean.subfolder.enabled": true,
    "latex-workshop.latex.tools": [
        {
            "name": "latexmk",
            "command": "latexmk",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-shell-escape",
                "-pdf",
                "-auxdir=%DIR%/build",
                "-outdir=%OUTDIR%",
                "%DOC%"
            ],
            "env": {
                "TEXMF_OUTPUT_DIRECTORY": "%DIR%/build"
            }
        }
    ],
    "latex-workshop.latex.recipes": [
        {
            "name": "latexmk",
            "tools": ["latexmk"]
        }
    ]
}
